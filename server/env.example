# =============================================================================
# DRAGON COUNCIL WORKSPACE ENVIRONMENT CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Neon PostgreSQL / Database)
# -----------------------------------------------------------------------------
# When DATABASE_URL, NEON_DATABASE_URL, or POSTGRES_URL is provided, the app automatically
# connects to Neon PostgreSQL. If omitted, it defaults to local SQLite persistence.
DATABASE_URL="postgres://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
# NEON_DATABASE_URL=""
# POSTGRES_URL=""

# -----------------------------------------------------------------------------
# 2. GEMINI AI API KEY
# -----------------------------------------------------------------------------
# Required for Gemini Kingdom Intelligence Brief generation in Command Desk.
GEMINI_API_KEY=""

# -----------------------------------------------------------------------------
# 3. DISCORD OAUTH AUTHENTICATION
# -----------------------------------------------------------------------------
# Required for Discord officer login, character claims, and farm account linking.
# Obtain from https://discord.com/developers/applications
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# 4. APPLICATION HOSTING & PORT CONFIGURATION
# -----------------------------------------------------------------------------
# Used for OAuth callbacks and canonical self-referential URLs.
# Example for Vercel: https://your-app.vercel.app
# Example for Render: https://your-app.onrender.com
APP_URL="http://localhost:3000"

# Server Port (automatically set by Render or Cloud Run; defaults to 3000)
PORT=3000
